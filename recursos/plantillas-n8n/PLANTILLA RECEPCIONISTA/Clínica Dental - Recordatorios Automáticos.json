    {
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "const cita = $input.item.json;\n\nlet mensaje = '';\n\nif (cita.tipo_recordatorio === '24h') {\n  mensaje = `¡Hola ${cita.Paciente_Nombre}! 👋\n\nTe recordamos que mañana tienes cita en Clínica Dental [NOMBRE].\n\n📅 Fecha: ${cita.Fecha_Cita}\n🕐 Hora: ${cita.Hora_Cita}\n🦷 Tratamiento: ${cita.Tipo_Cita}\n\n📍 Dirección: [CONFIGURAR DIRECCIÓN]\n\nPor favor, llega 10 minutos antes de tu cita. Si necesitas cancelar o modificar, responde a este mensaje.\n\n¡Te esperamos!`;\n} else {\n  mensaje = `¡Hola ${cita.Paciente_Nombre}! 👋\n\nTu cita es en aproximadamente 1 hora.\n\n🕐 Hora: ${cita.Hora_Cita}\n🦷 Tratamiento: ${cita.Tipo_Cita}\n\n📍 Dirección: La casa del Ratoncito Pérez N7. Ratolandia\n\n¡Te esperamos pronto!`;\n}\n\nreturn {\n  json: {\n    ...cita,\n    mensaje: mensaje\n  }\n};"
      },
